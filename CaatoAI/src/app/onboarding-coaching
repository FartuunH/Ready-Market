import { router, useLocalSearchParams } from "expo-router";
import { useState } from "react";
import {
  Pressable,
  ScrollView,
  StyleSheet,
  Text,
  View,
} from "react-native";

type CoachingStyle =
  | "gentle"
  | "balanced"
  | "direct"
  | "accountability";

const OPTIONS: {
  id: CoachingStyle;
  emoji: string;
  title: string;
  description: string;
}[] = [
  {
    id: "gentle",
    emoji: "💚",
    title: "Si deggan oo dhiirrigelin leh",
    description:
      "I taageer oo i dhiirrigeli, xitaa marka maalintu ii socon weydo sidii aan rabay.",
  },
  {
    id: "balanced",
    emoji: "🌿",
    title: "Taageero iyo xasuusin isku dheelitiran",
    description:
      "I dhiirrigeli, laakiin sidoo kale i xasuusi hadafka aan u socdo.",
  },
  {
    id: "direct",
    emoji: "🎯",
    title: "Si toos ah ii sheeg",
    description:
      "Waxaan jeclahay talo cad iyo tallaabada xigta ee aan qaadi karo.",
  },
  {
    id: "accountability",
    emoji: "🔥",
    title: "Ila xisaabtan",
    description:
      "I xasuusi commitments-kayga oo iga caawi inaan dib ugu soo laabto marka aan ka leexdo.",
  },
];

export default function OnboardingCoachingScreen() {
  const params = useLocalSearchParams();

  const name =
    typeof params.name === "string" ? params.name : "";

  const [selected, setSelected] =
    useState<CoachingStyle | null>(null);

  const canContinue = selected !== null;

  const selectedOption = OPTIONS.find(
    (option) => option.id === selected
  );

  const continueNext = () => {
    if (!selected || !selectedOption) return;

    router.push({
      pathname: "/onboarding-location",
      params: {
        ...params,
        coachingStyle: selected,
        coachingStyleLabel: selectedOption.title,
      },
    });
  };

  return (
    <ScrollView
      style={styles.screen}
      contentContainerStyle={styles.scrollContent}
      showsVerticalScrollIndicator={false}
    >
      <View style={styles.container}>
        {/* TOP */}

        <View style={styles.topRow}>
          <Pressable
            onPress={() => router.back()}
            style={({ pressed }) => [
              styles.backButton,
              pressed && styles.pressed,
            ]}
          >
            <Text style={styles.backArrow}>‹</Text>
          </Pressable>

          <View style={styles.progressArea}>
            <View style={styles.progressTrack}>
              <View style={styles.progressFill} />
            </View>

            <Text style={styles.progressText}>
              Waxaan kuu dhisaynaa qorshe kuu gaar ah
            </Text>
          </View>
        </View>

        {/* COACH */}

        <View style={styles.coachRow}>
          <View style={styles.coachIcon}>
            <Text style={styles.coachEmoji}>🌿</Text>
          </View>

          <View style={styles.coachTextArea}>
            <Text style={styles.coachName}>CaatoAI</Text>

            <Text style={styles.coachLabel}>
              Adiga ayaa dooranaya sida aan kuu taageero
            </Text>
          </View>
        </View>

        {/* PERSONAL */}

        {name ? (
          <View style={styles.personalCard}>
            <Text style={styles.personalEmoji}>💚</Text>

            <Text style={styles.personalText}>
              {name}, dadka oo dhan isku nooc taageero ah uma
              baahna. Waxaan rabaa inaan kula hadlo qaab adiga kuu
              shaqeeya.
            </Text>
          </View>
        ) : null}

        {/* HERO */}

        <View style={styles.hero}>
          <View style={styles.stepBadge}>
            <Text style={styles.stepBadgeText}>
              TABABARAHAAGA
            </Text>
          </View>

          <Text style={styles.title}>
            Sidee ayaad rabtaa CaatoAI{"\n"}
            <Text style={styles.titleGreen}>
              inuu kuu taageero?
            </Text>
          </Text>

          <Text style={styles.subtitle}>
            Dooro qaabka kuugu fiican. Waxaad mar dambe ka beddeli
            kartaa settings-kaaga.
          </Text>

          <View style={styles.oneBadge}>
            <Text style={styles.oneBadgeText}>
              ✓ Dooro hal qaab
            </Text>
          </View>
        </View>

        {/* OPTIONS */}

        <View style={styles.optionsArea}>
          {OPTIONS.map((option) => {
            const isSelected = selected === option.id;

            return (
              <Pressable
                key={option.id}
                onPress={() => setSelected(option.id)}
                style={({ pressed }) => [
                  styles.optionCard,
                  isSelected && styles.optionCardSelected,
                  pressed && styles.optionPressed,
                ]}
              >
                <View
                  style={[
                    styles.optionIcon,
                    isSelected && styles.optionIconSelected,
                  ]}
                >
                  <Text style={styles.optionEmoji}>
                    {option.emoji}
                  </Text>
                </View>

                <View style={styles.optionTextArea}>
                  <Text
                    style={[
                      styles.optionTitle,
                      isSelected && styles.optionTitleSelected,
                    ]}
                  >
                    {option.title}
                  </Text>

                  <Text style={styles.optionDescription}>
                    {option.description}
                  </Text>
                </View>

                <View
                  style={[
                    styles.radioOuter,
                    isSelected && styles.radioOuterSelected,
                  ]}
                >
                  {isSelected && <View style={styles.radioInner} />}
                </View>
              </Pressable>
            );
          })}
        </View>

        {/* PREVIEW */}

        {selectedOption && (
          <View style={styles.previewCard}>
            <View style={styles.previewTop}>
              <View style={styles.previewIcon}>
                <Text style={styles.previewEmoji}>✨</Text>
              </View>

              <View style={styles.previewHeading}>
                <Text style={styles.previewLabel}>
                  TUSAALE CAATOAI
                </Text>

                <Text style={styles.previewTitle}>
                  Sidaan ayaan kuu taageeri karaa
                </Text>
              </View>
            </View>

            {selected === "gentle" && (
              <Text style={styles.previewText}>
                “Maalin adag way dhici kartaa 💚. Hal doorasho oo
                yar oo maanta kuu wanaagsan ayaa ku filan inaan
                safarka sii wadno.”
              </Text>
            )}

            {selected === "balanced" && (
              <Text style={styles.previewText}>
                “Waxaad samaysay horumar wanaagsan 🌿. Aan maanta
                diiradda saarno hal hadaf oo yar si aan jidka ugu
                sii jirno.”
              </Text>
            )}

            {selected === "direct" && (
              <Text style={styles.previewText}>
                “Hadafka maanta: socodkaaga dhammee, biyahaaga cab,
                oo cashada ku dar protein. 🎯”
              </Text>
            )}

            {selected === "accountability" && (
              <Text style={styles.previewText}>
                “Waxaad qorshaysay inaad maanta socoto. 🔥 Aan
                hubinno: ma samaysay mise waxaan kuu samaynaa waqti
                kale oo maanta ah?”
              </Text>
            )}
          </View>
        )}

        {/* MESSAGE */}

        <View style={styles.infoCard}>
          <View style={styles.infoIcon}>
            <Text style={styles.infoEmoji}>🧠</Text>
          </View>

          <View style={styles.infoTextArea}>
            <Text style={styles.infoTitle}>
              Taageeradu way is beddeli kartaa
            </Text>

            <Text style={styles.infoText}>
              Waxaa jiri kara maalmo aad u baahan tahay dhiirrigelin
              iyo maalmo aad rabto tallaabo cad. Qaabkan wuxuu noo
              siinayaa meel aan ka bilowno.
            </Text>
          </View>
        </View>

        {/* HABIT */}

        <View style={styles.habitCard}>
          <Text style={styles.habitEmoji}>🌱</Text>

          <View style={styles.habitTextArea}>
            <Text style={styles.habitTitle}>
              CaatoAI ma joogo inuu ku xukumo
            </Text>

            <Text style={styles.habitText}>
              Haddii aad maalin ka baxdo qorshahaaga, waxaan kaa
              caawin doonaa tallaabada xigta halkii aan maalintaas
              u arki lahayn guuldarro.
            </Text>
          </View>
        </View>

        {/* BUTTON */}

        <View style={styles.bottomArea}>
          <Pressable
            disabled={!canContinue}
            onPress={continueNext}
            style={({ pressed }) => [
              styles.button,
              !canContinue && styles.buttonDisabled,
              pressed && canContinue && styles.buttonPressed,
            ]}
          >
            <Text style={styles.buttonText}>Sii wad</Text>
            <Text style={styles.buttonArrow}>→</Text>
          </Pressable>

          <Text style={styles.bottomText}>
            💚 Waxaad qaabka tababarahaaga beddeli kartaa mar kasta.
          </Text>
        </View>
      </View>
    </ScrollView>
  );
}

